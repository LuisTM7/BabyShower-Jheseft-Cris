---
const amazonUrl = "https://www.amazon.com/baby-reg/cristinamarquez-berrocal-junio-2026-lawnside/26LQDPMH50C2D?ref_=cm_sw_r_apin_dp_QB8ZZ43KFAM1S91DMTMH&language=en-US";
---

<section class="gifts" id="regalos">
  <img src="/images/estrella1.png" alt="" class="gifts__deco gifts__star gifts__star--1" aria-hidden="true" />
  <img src="/images/estrella2.png" alt="" class="gifts__deco gifts__star gifts__star--2" aria-hidden="true" />
  <img src="/images/estrella1.png" alt="" class="gifts__deco gifts__star gifts__star--3" aria-hidden="true" />
  <img src="/images/estrella2.png" alt="" class="gifts__deco gifts__star gifts__star--4" aria-hidden="true" />
  <img src="/images/zapatitos.png" alt="" class="gifts__deco gifts__zapatitos" aria-hidden="true" />
  <img src="/images/sonaja.png"    alt="" class="gifts__deco gifts__sonaja"    aria-hidden="true" />

  <div class="container">
    <div class="gifts__card fade-in">

      <div class="gifts__icon-wrap">
        <span class="gifts__icon">✨</span>
      </div>

      <h2 class="gifts__title">Lista de Deseos para el Bebé</h2>

      <div class="gifts__divider">
        <img src="/images/oso-solo.png" alt="" width="32" height="32" style="object-fit:contain;" aria-hidden="true" />
      </div>

      <p class="gifts__text">
        Con mucho amor preparamos una selección de cositas que serán útiles
        para la llegada de nuestro pequeño.
      </p>

      <a
        href={amazonUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="gifts__btn"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 12V22H4V12"/>
          <path d="M22 7H2v5h20V7z"/>
          <path d="M12 22V7"/>
          <path d="M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z"/>
          <path d="M12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/>
        </svg>
        Ir a la lista de regalos
      </a>

      <p class="gifts__note">🤍 Abrirá Amazon en una nueva pestaña</p>
    </div>
  </div>
</section>

<style>
  .gifts {
    background: linear-gradient(160deg, #fdf8f0 0%, #eef6fb 60%, #fdf8f0 100%);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .gifts__deco {
    position: absolute;
    pointer-events: none;
    user-select: none;
  }

  .gifts__star {
    opacity: 0.8;
    animation: float 6s ease-in-out infinite;
  }

  .gifts__star--1 { top: 8%;    left: 5%;   width: clamp(24px, 5vw, 38px); animation-delay: 0s; }
  .gifts__star--2 { top: 15%;   right: 6%;  width: clamp(20px, 4vw, 32px); animation-delay: 0.8s; }
  .gifts__star--3 { bottom: 20%; left: 8%;  width: clamp(22px, 4.5vw, 34px); animation-delay: 1.5s; }
  .gifts__star--4 { bottom: 12%; right: 7%; width: clamp(18px, 4vw, 28px); animation-delay: 2.2s; }

  .gifts__zapatitos {
    bottom: 0;
    left: -10px;
    width: clamp(70px, 18vw, 110px);
    opacity: 0.75;
    transform: rotate(-10deg);
    animation: float 8s ease-in-out infinite;
    animation-delay: 1s;
  }

  .gifts__sonaja {
    top: 0;
    right: -10px;
    width: clamp(70px, 18vw, 110px);
    opacity: 0.75;
    transform: rotate(15deg);
    animation: float 7s ease-in-out infinite;
    animation-delay: 0.5s;
  }

  .gifts__card {
    background: white;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    max-width: 520px;
    margin: 0 auto;
    padding: clamp(36px, 8vw, 56px) clamp(24px, 6vw, 48px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    border-top: 4px solid var(--color-blue-baby);
  }

  .gifts__icon-wrap {
    width: 64px;
    height: 64px;
    background: linear-gradient(135deg, var(--color-blue-light), var(--color-beige));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(90, 158, 200, 0.2);
  }

  .gifts__icon {
    font-size: 1.8rem;
    line-height: 1;
  }

  .gifts__title {
    font-size: clamp(1.6rem, 5vw, 2.2rem);
    color: var(--color-brown-dark);
    margin: 0;
    line-height: 1.2;
  }

  .gifts__divider {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    justify-content: center;
  }

  .gifts__divider::before,
  .gifts__divider::after {
    content: '';
    display: block;
    flex: 1;
    height: 1px;
    background: var(--color-beige-dark);
    max-width: 80px;
  }

  .gifts__text {
    color: var(--color-text-soft);
    font-size: 1rem;
    line-height: 1.75;
    max-width: 380px;
  }

  .gifts__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--color-brown-dark);
    color: white;
    text-decoration: none;
    padding: 15px 32px;
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-size: 1rem;
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 6px 20px rgba(159, 118, 84, 0.35);
    margin-top: 4px;
  }

  .gifts__btn:hover {
    background: var(--color-brown-warm);
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(159, 118, 84, 0.45);
  }

  .gifts__note {
    font-size: 0.8rem;
    color: var(--color-text-soft);
    opacity: 0.75;
    margin-top: -6px;
  }
</style>
