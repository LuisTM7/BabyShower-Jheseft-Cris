---
---

<section class="parents" id="parents">
<img src="/images/corazon-azul.png"   alt="" class="parents__deco parents__heart parents__heart--1"  aria-hidden="true" />
  <img src="/images/corazon-marron.png" alt="" class="parents__deco parents__heart parents__heart--2"  aria-hidden="true" />
  <img src="/images/corazon-azul.png"   alt="" class="parents__deco parents__heart parents__heart--3"  aria-hidden="true" />
  <img src="/images/corazon-marron.png" alt="" class="parents__deco parents__heart parents__heart--4"  aria-hidden="true" />
  <img src="/images/corazon-azul.png"   alt="" class="parents__deco parents__heart parents__heart--5"  aria-hidden="true" />
  <img src="/images/corazon-marron.png" alt="" class="parents__deco parents__heart parents__heart--6"  aria-hidden="true" />
  <img src="/images/corazon-azul.png"   alt="" class="parents__deco parents__heart parents__heart--7"  aria-hidden="true" />
  <img src="/images/corazon-marron.png" alt="" class="parents__deco parents__heart parents__heart--8"  aria-hidden="true" />
  <img src="/images/corazon-azul.png"   alt="" class="parents__deco parents__heart parents__heart--9"  aria-hidden="true" />
  <img src="/images/corazon-marron.png" alt="" class="parents__deco parents__heart parents__heart--10" aria-hidden="true" />
  <div class="container">
    <h2 class="section-title fade-in">Los futuros papás</h2>
    <div class="section-divider fade-in fade-in-delay-1">
      <img src="/images/oso-solo.png" alt="" width="36" height="36" style="object-fit:contain;" aria-hidden="true" />
    </div>

    <div class="parents__frame fade-in fade-in-delay-2">
      <div class="parents__img-wrap">
        <img
          src="/images/padres.jpg"
          alt="Jheseft y Cris"
          class="parents__img"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        />
        <div class="parents__placeholder" style="display:none;">
          <div class="parents__placeholder-inner">
            <svg width="64" height="64" viewBox="0 0 64 64" fill="none">
              <circle cx="32" cy="22" r="14" fill="var(--color-beige-dark)"/>
              <path d="M8 58 C8 44 18 36 32 36 C46 36 56 44 56 58" fill="var(--color-beige-dark)"/>
              <circle cx="20" cy="22" r="10" fill="var(--color-blue-light)"/>
              <path d="M4 52 C4 41 11 34 20 34 C29 34 36 41 36 52" fill="var(--color-blue-light)"/>
            </svg>
            <p>Foto de los papás</p>
            <small>Reemplaza src/images/parents.jpg</small>
          </div>
        </div>
      </div>

      <!-- Decorative corners -->
      <div class="frame-corner frame-corner--tl"></div>
      <div class="frame-corner frame-corner--tr"></div>
      <div class="frame-corner frame-corner--bl"></div>
      <div class="frame-corner frame-corner--br"></div>
    </div>

    <div class="parents__caption fade-in fade-in-delay-3">
      <p class="parents__caption-names">Jheseft &amp; Cris</p>
      <p class="parents__caption-sub">próximamente una familia de tres 💙</p>
    </div>
  </div>
</section>

<style>
  .parents {
    background: var(--color-cream);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .parents__deco {
    position: absolute;
    pointer-events: none;
    user-select: none;
  }

.parents__heart {
    opacity: 0.75;
    animation: float 7s ease-in-out infinite;
  }

  /* azul=1,3,5,7,9  marron=2,4,6,8,10 — mezclados en ambos lados */
  .parents__heart--1  { top: 5%;     left: 4%;   width: clamp(40px, 10vw, 64px); animation-delay: 0s;   }
  .parents__heart--2  { top: 12%;    left: 2%;   width: clamp(32px, 8vw, 52px);  animation-delay: 0.7s; }
  .parents__heart--3  { top: 6%;     right: 5%;  width: clamp(28px, 7vw, 44px);  animation-delay: 1.4s; }
  .parents__heart--4  { top: 28%;    right: 3%;  width: clamp(36px, 9vw, 58px);  animation-delay: 2.1s; }
  .parents__heart--5  { top: 42%;    left: 5%;   width: clamp(30px, 7vw, 48px);  animation-delay: 0.3s; }
  .parents__heart--6  { top: 38%;    left: 2%;   width: clamp(26px, 6vw, 40px);  animation-delay: 1s;   }
  .parents__heart--7  { top: 55%;    right: 4%;  width: clamp(34px, 8vw, 54px);  animation-delay: 1.8s; }
  .parents__heart--8  { bottom: 22%; left: 6%;   width: clamp(28px, 7vw, 46px);  animation-delay: 2.5s; }
  .parents__heart--9  { bottom: 10%; right: 7%;  width: clamp(24px, 6vw, 38px);  animation-delay: 0.6s; }
  .parents__heart--10 { bottom: 5%;  right: 14%; width: clamp(30px, 7vw, 50px);  animation-delay: 1.3s; }

  .parents__frame {
    position: relative;
    display: inline-block;
    margin: 0 auto 24px;
  }

  .parents__img-wrap {
    width: clamp(260px, 80vw, 420px);
    height: clamp(300px, 90vw, 480px);
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    border: 6px solid var(--color-cream);
    outline: 2px solid var(--color-beige-dark);
  }

  .parents__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .parents__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(145deg, var(--color-beige) 0%, var(--color-blue-light) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .parents__placeholder-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    color: var(--color-text-soft);
  }

  .parents__placeholder-inner p {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-brown-warm);
  }

  .parents__placeholder-inner small {
    font-size: 0.75rem;
    opacity: 0.7;
  }

  /* Decorative frame corners */
  .frame-corner {
    position: absolute;
    width: 24px;
    height: 24px;
    border-color: var(--color-blue-mid);
    border-style: solid;
  }

  .frame-corner--tl { top: -10px; left: -10px; border-width: 3px 0 0 3px; border-radius: 6px 0 0 0; }
  .frame-corner--tr { top: -10px; right: -10px; border-width: 3px 3px 0 0; border-radius: 0 6px 0 0; }
  .frame-corner--bl { bottom: -10px; left: -10px; border-width: 0 0 3px 3px; border-radius: 0 0 0 6px; }
  .frame-corner--br { bottom: -10px; right: -10px; border-width: 0 3px 3px 0; border-radius: 0 0 6px 0; }

  .parents__caption {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .parents__caption-names {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 5vw, 2rem);
    font-style: italic;
    color: var(--color-brown-dark);
    font-weight: 600;
  }

  .parents__caption-sub {
    color: var(--color-text-soft);
    font-size: 0.95rem;
    font-weight: 400;
  }
</style>
