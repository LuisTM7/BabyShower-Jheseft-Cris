---
const msgPadre = encodeURIComponent("¡Hola Jheseft! Confirmo mi asistencia al Dedicación el 5 de julio 💙");
const msgMadre = encodeURIComponent("¡Hola Cris! Confirmo mi asistencia al Dedicación el 5 de julio 💙");

const numeroPadre = "12406412974";
const numeroMadre = "18566337029";

const urlPadre = `https://wa.me/${numeroPadre}?text=${msgPadre}`;
const urlMadre = `https://wa.me/${numeroMadre}?text=${msgMadre}`;
---

<section class="rsvp" id="rsvp">
  <img src="/images/estrella1.png" alt="" class="rsvp__deco rsvp__star rsvp__star--1" aria-hidden="true" />
  <img src="/images/estrella2.png" alt="" class="rsvp__deco rsvp__star rsvp__star--2" aria-hidden="true" />
  <img src="/images/estrella1.png" alt="" class="rsvp__deco rsvp__star rsvp__star--3" aria-hidden="true" />
  <img src="/images/estrella2.png" alt="" class="rsvp__deco rsvp__star rsvp__star--4" aria-hidden="true" />
  <img src="/images/estrella1.png" alt="" class="rsvp__deco rsvp__star rsvp__star--5" aria-hidden="true" />
  <img src="/images/estrella2.png" alt="" class="rsvp__deco rsvp__star rsvp__star--6" aria-hidden="true" />
  <img src="/images/estrella1.png" alt="" class="rsvp__deco rsvp__star rsvp__star--7" aria-hidden="true" />
  <img src="/images/estrella2.png" alt="" class="rsvp__deco rsvp__star rsvp__star--8" aria-hidden="true" />
  <img src="/images/estrella1.png" alt="" class="rsvp__deco rsvp__star rsvp__star--9" aria-hidden="true" />
  <img src="/images/estrella2.png" alt="" class="rsvp__deco rsvp__star rsvp__star--10" aria-hidden="true" />

  <div class="container">
    <div class="rsvp__card fade-in">
      <!-- Bear accent -->
      <div class="rsvp__bear-mini">
        <img src="/images/oso-pack2.png" alt="Osito" width="130" style="object-fit:contain;" />
      </div>

      <h2 class="rsvp__title">¿Nos acompañas?</h2>
      <p class="rsvp__subtitle">Confirma tu asistencia</p>
      <p class="rsvp__text">
        Tu presencia es el mejor regalo para celebrar la llegada de nuestro pequeño.<br/>
        <strong>Confírmanos antes del 28 de Junio 2026</strong>
      </p>

      <div class="rsvp__buttons">
        <!-- Padre -->
        <div class="rsvp__contact">
          <p class="rsvp__contact-label">👨 Confirmar con Jheseft</p>
          <a href={urlPadre} target="_blank" rel="noopener noreferrer" class="rsvp__btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            WhatsApp
          </a>
        </div>

        <!-- Madre -->
        <div class="rsvp__contact">
          <p class="rsvp__contact-label">👩 Confirmar con Cris</p>
          <a href={urlMadre} target="_blank" rel="noopener noreferrer" class="rsvp__btn rsvp__btn--madre">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            WhatsApp
          </a>
        </div>
      </div>

      <p class="rsvp__note">💙 ¡Los esperamos con los brazos abiertos!</p>
    </div>
  </div>
</section>

<style>
  .rsvp {
    background: linear-gradient(160deg, var(--color-blue-light) 0%, var(--color-beige) 100%);
    padding-top: 0;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .rsvp__deco {
    position: absolute;
    pointer-events: none;
    user-select: none;
  }

  .rsvp__star {
    width: clamp(28px, 7vw, 48px);
    opacity: 0.85;
    animation: float 6s ease-in-out infinite;
  }

  .rsvp__star--1  { top: 6%;    left: 5%;   animation-delay: 0s;   }
  .rsvp__star--2  { top: 12%;   right: 6%;  animation-delay: 0.6s; width: clamp(22px, 5vw, 36px); }
  .rsvp__star--3  { bottom: 10%; left: 7%;  animation-delay: 1.2s; width: clamp(20px, 4vw, 30px); }
  .rsvp__star--4  { bottom: 18%; right: 5%; animation-delay: 1.8s; }
  .rsvp__star--5  { top: 42%;   left: 3%;  animation-delay: 2.4s; width: clamp(18px, 4vw, 28px); }
  .rsvp__star--6  { top: 28%;   right: 3%; animation-delay: 0.3s; width: clamp(16px, 3.5vw, 26px); }
  .rsvp__star--7  { top: 55%;   left: 10%; animation-delay: 1s;   width: clamp(22px, 5vw, 34px); }
  .rsvp__star--8  { bottom: 30%; right: 8%; animation-delay: 2s;  width: clamp(18px, 4vw, 28px); }
  .rsvp__star--9  { top: 70%;   left: 4%;  animation-delay: 3s;   width: clamp(16px, 3vw, 24px); }
  .rsvp__star--10 { bottom: 5%;  right: 12%; animation-delay: 1.4s; width: clamp(20px, 4.5vw, 32px); }

  .rsvp__bg-wave {
    width: 100%;
    line-height: 0;
    margin-bottom: -2px;
  }

  .rsvp__bg-wave svg {
    display: block;
    width: 100%;
  }

  .rsvp__card {
    background: white;
    border-radius: var(--radius-card);
    padding: clamp(32px, 8vw, 56px) clamp(24px, 6vw, 48px);
    box-shadow: var(--shadow-card);
    max-width: 520px;
    margin: 32px auto 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .rsvp__bear-mini {
    margin-bottom: -4px;
  }

  .rsvp__title {
    font-size: clamp(1.8rem, 6vw, 2.4rem);
    color: var(--color-brown-dark);
    margin-bottom: 0;
  }

  .rsvp__subtitle {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-blue-mid);
    font-weight: 700;
  }

  .rsvp__text {
    color: var(--color-text-soft);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .rsvp__buttons {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
    margin-top: 4px;
  }

  .rsvp__contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .rsvp__contact-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-soft);
  }

  .rsvp__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #25D366;
    color: white;
    text-decoration: none;
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-size: 0.95rem;
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.35);
  }

  .rsvp__btn--madre {
    background: #e8a0b4;
    box-shadow: 0 6px 20px rgba(232, 160, 180, 0.35);
  }

  .rsvp__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.45);
    background: #1ebe5d;
  }

  .rsvp__btn--madre:hover {
    background: #d9849d;
    box-shadow: 0 8px 24px rgba(232, 160, 180, 0.45);
  }

  .rsvp__note {
    color: var(--color-text-soft);
    font-size: 0.9rem;
    margin-top: -4px;
  }
</style>
