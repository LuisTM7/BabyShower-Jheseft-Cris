<section class="map-section" id="map">
  <div class="container">
    <h2 class="section-title fade-in">¿Cómo llegar?</h2>
    <p class="section-subtitle fade-in fade-in-delay-1">224 E Charleston Ave, Lawnside, NJ 08045</p>
  </div>

  <div class="map-section__wrap fade-in fade-in-delay-2">
    <div class="map-section__frame">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d6124.882326369745!2d-75.024944!3d39.864355!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c6cc526b5c802b%3A0xfce034767a3348e9!2s224%20E%20Charleston%20Ave%2C%20Lawnside%2C%20NJ%2008045!5e0!3m2!1sen!2sus!4v1779686996499!5m2!1sen!2sus"
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Ubicación de la Dedicación"
      ></iframe>
    </div>

    <a
      href="https://www.google.com/maps/dir/?api=1&destination=224+E+Charleston+Ave,+Lawnside,+NJ+08045"
      target="_blank"
      rel="noopener noreferrer"
      class="map-section__btn"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" fill="currentColor"/>
        <circle cx="12" cy="9" r="2.5" fill="white"/>
      </svg>
      Abrir en Google Maps
    </a>
  </div>
</section>

<style>
  .map-section {
    background: var(--color-beige);
    text-align: center;
  }

  .map-section .container {
    margin-bottom: 0;
  }

  .map-section__wrap {
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .map-section__frame {
    width: 100%;
    height: clamp(280px, 50vw, 420px);
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    border: 4px solid white;
  }

  .map-section__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-blue-mid);
    color: white;
    text-decoration: none;
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: 0.95rem;
    transition: background 0.2s ease, transform 0.2s ease;
    box-shadow: 0 4px 16px rgba(123, 184, 212, 0.35);
  }

  .map-section__btn:hover {
    background: var(--color-brown-warm);
    transform: translateY(-2px);
  }
</style>
